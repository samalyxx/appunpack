{
  "name": "@samalyxx/appunpack",
  "version": "0.1.0",
  "description": "Local Android APK reverse engineering: decompiled Java, decoded resources, evidence reports and MCP tools.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/samalyxx/appunpack.git" },
  "homepage": "https://samalyxx.github.io/appunpack/",
  "bugs": { "url": "https://github.com/samalyxx/appunpack/issues" },
  "bin": { "appunpack": "bin/appunpack.mjs" },
  "engines": { "node": ">=24.11.0" },
  "keywords": ["android", "apk", "reverse-engineering", "decompiler", "jadx", "static-analysis", "mcp"],
  "files": ["bin", "appunpack.ps1", "src/*.mjs", "src/*.py", "src/*.java", "docs", "skills", "site/assets/*.svg", "README.md", "CHANGELOG.md", "LICENSE", "THIRD_PARTY_NOTICES.md", "SECURITY.md"],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:ios": "python -m unittest discover -s tests -p test_ipa.py",
    "start": "node bin/appunpack.mjs"
  },
  "dependencies": { "@modelcontextprotocol/client": "2.3.1" }
}
